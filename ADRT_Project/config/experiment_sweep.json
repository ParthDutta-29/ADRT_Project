{
    "experiment_metadata": {
        "title": "Phase 10: Parameter Sensitivity & Congestion Sweep",
        "description": "Evaluates bounded stochastic cyber-physical resilience dynamics under varying mitigation capacity and stealth preference.",
        "model_file": "../build/main_system.xml",
        "query_file": "../validation/experimental_queries.q",
        "repetitions": 100
    },
    "parameter_sweeps": [
        {
            "experiment_id": "EXP-01-CAPACITY-SWEEP",
            "parameter": "mitigationCapacity",
            "range": [20, 50, 80],
            "metrics_to_collect": ["resilienceDegradation", "fwQueueSize", "maintenanceCost"]
        },
        {
            "experiment_id": "EXP-02-STEALTH-SWEEP",
            "parameter": "stealthPreference",
            "range": [30, 60, 90],
            "metrics_to_collect": ["telemetryTrust", "alertConfidence", "safeModeOperation"]
        },
        {
            "experiment_id": "EXP-03-STRESS-SWEEP",
            "parameter": "operationalStress",
            "range": [10, 50, 90],
            "metrics_to_collect": ["controlLatency", "processDeviation", "energyCost"]
        }
    ]
}
